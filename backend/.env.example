# Konfigurasi Port Server Termux
PORT=3000
DB_PATH=./database.sqlite

# Kredensial Administrator Tunggal (Wajib dirahasiakan di server Termux)
ADMIN_USERNAME=sppln

# Opsi 1: Masukkan password administrator yang kuat di sini (minimal 10 karakter, ada huruf besar, huruf kecil, angka, dan simbol khusus)
# Password ini akan di-hash otomatis menggunakan PBKDF2 (SHA-512, 100.000 iterasi) saat server pertama kali start / migrasi
ADMIN_PASSWORD=ContohPasswordKuat2026!

# Opsi 2 (Lebih aman): Masukkan hash password PBKDF2 langsung jika tidak ingin menulis password plaintext di file env
# ADMIN_PASSWORD_HASH=

# Salt rahasia untuk pembuatan dan verifikasi hash password
ADMIN_PASSWORD_SALT=sp_pln_uid_kalbar_salt_2026

# Kunci rahasia sesi token
SESSION_SECRET=sp_pln_uid_kalbar_session_secret_key_2026
