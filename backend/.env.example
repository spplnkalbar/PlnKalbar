# Konfigurasi Port Server Termux
PORT=3000
DB_PATH=./database.sqlite

# Kredensial Administrator Tunggal (Wajib dirahasiakan di server Termux)
ADMIN_USERNAME=admin

# Opsi 1: Masukkan password plaintext di sini saat pertama kali menjalankan server (akan di-hash otomatis dengan PBKDF2-SHA512)
ADMIN_PASSWORD=spplnkalbar2026

# Opsi 2 (Lebih aman): Masukkan hash password PBKDF2 langsung jika tidak ingin menulis password plaintext
# ADMIN_PASSWORD_HASH=

# Salt rahasia untuk pembuatan dan verifikasi hash password
ADMIN_PASSWORD_SALT=sp_pln_uid_kalbar_salt_2026

# Kunci rahasia sesi token
SESSION_SECRET=sp_pln_uid_kalbar_session_secret_key_2026
