# Konfigurasi Port Server
PORT=3000

# Path Database SQLite Existing (Gunakan file berita.db existing)
DB_PATH=./berita.db

# Salt rahasia untuk verifikasi PBKDF2 (digunakan jika hash tidak menyertakan salt per-entry)
ADMIN_PASSWORD_SALT=sp_pln_uid_kalbar_salt_2026

# Kunci rahasia sesi token
SESSION_SECRET=sp_pln_uid_kalbar_session_secret_key_2026
